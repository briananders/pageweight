{
  "name": "@briananders/pageweight",
  "version": "2.0.0",
  "description": "Simple node package that calculates the overall weight of a webpage on initial load without click interactions.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "pageweight": "./dist/bin/pageweight.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "clean": "node -e \"import('node:fs').then((fs) => fs.rmSync('dist', { recursive: true, force: true }))\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/briananders/pageweight.git"
  },
  "keywords": [
    "pageweight",
    "page weight",
    "page weight analysis",
    "page weight audit",
    "page weight calculator",
    "page weight measurement",
    "page weight optimization",
    "page weight reduction audit",
    "page weight reduction measurement",
    "page weight reduction optimization",
    "page weight reduction tool",
    "page weight reduction",
    "page weight tool",
    "performance",
    "web",
    "chrome",
    "puppeteer",
    "typescript"
  ],
  "author": "Brian Anders <brian.steven.anders@gmail.com>",
  "license": "ISC",
  "engines": {
    "node": ">=26.0.0"
  },
  "bugs": {
    "url": "https://github.com/briananders/pageweight/issues"
  },
  "homepage": "https://github.com/briananders/pageweight#readme",
  "dependencies": {
    "puppeteer": "^25.18.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "puppeteer@25.18.1": true
  }
}
